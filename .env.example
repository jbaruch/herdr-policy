# CI review secret: https://github.com/jbaruch/herdr-policy/settings/secrets/actions
# Publisher environment: https://github.com/jbaruch/herdr-policy/settings/environments
# The publish environment permits only main; its key is never a repository secret.
# Optional absolute coding-policy package/source root. Exclusive selection;
# incomplete bundles fail instead of borrowing helpers from another version.
# Normal Tessl and ACR installations resolve the co-installed release skill.
HERDR_CODING_POLICY_ROOT=

# Live TypeSafe report classification. Obtain a key at https://console.typesafe.ai
# (https://docs.typesafe.ai/introduction/quickstart). Unit tests use fake clients.
TYPESAFE_API_KEY=

# Non-publishing member key for baseline fetching and an isolated skill-review job.
# tessl api-key create --workspace jbaruch --name herdr-policy-review-ci --role member --ttl 1y
# Store as a repository Actions secret. Never run PR scripts in the review job.
TESSL_REVIEW_TOKEN=

# Publisher key only in the main-restricted publish environment above.
# tessl api-key create --workspace jbaruch --name herdr-policy-publish-ci --role publisher --ttl 1y
# Store as an environment secret, never a repository secret or worker setting.
# Both current CI keys expire in October 2027; rotate before expiry and after revocation.
TESSL_PUBLISH_TOKEN=

# Ephemeral GitHub Actions read token, supplied only to trusted ACR source installs.
# https://docs.github.com/actions/security-guides/automatic-token-authentication
# Candidate hook/owner execution receives an allowlisted environment without it.
GH_TOKEN=

# Starts central policy review for same-repository PRs. Codex subscription auth
# stays in jbaruch/coding-policy; this repository holds no CODEX_AUTH_JSON.
# Create a GitHub fine-grained token with Actions: read/write on coding-policy.
# Store only as an Actions secret at the repository secrets URL above.
# Rotate on expiry or revocation; update that secret, never this placeholder.
FLEET_DISPATCH_TOKEN=
