{
  "name": "jbaruch/herdr-policy",
  "version": "0.11.0",
  "description": "Herdr team coordination policy for AI coding agents",
  "private": false,
  "repository": "https://github.com/jbaruch/herdr-policy",
  "rules": [
    "rules/herdr-scope.md"
  ],
  "skills": [
    "skills/herdr-foreman",
    "skills/herdr-standup"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash",
            "args": [
              "${TESSL_PLUGIN_DIR}/skills/herdr-foreman/native-hook.sh",
              "session-start",
              "portable"
            ]
          }
        ]
      }
    ]
  },
  "nativeHooks": {
    "claude-code": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "bash \"${TESSL_PLUGIN_DIR}/skills/herdr-foreman/native-hook.sh\" session-start claude-code"
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "bash \"${TESSL_PLUGIN_DIR}/skills/herdr-foreman/native-hook.sh\" reset-input"
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "bash \"${TESSL_PLUGIN_DIR}/skills/herdr-foreman/native-hook.sh\" supervision-stop"
            }
          ]
        }
      ]
    },
    "codex": {
      "SessionStart": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "bash \"${TESSL_PLUGIN_DIR}/skills/herdr-foreman/native-hook.sh\" session-start codex"
            }
          ]
        }
      ],
      "UserPromptSubmit": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "bash \"${TESSL_PLUGIN_DIR}/skills/herdr-foreman/native-hook.sh\" reset-input"
            }
          ]
        }
      ],
      "Stop": [
        {
          "hooks": [
            {
              "type": "command",
              "command": "bash \"${TESSL_PLUGIN_DIR}/skills/herdr-foreman/native-hook.sh\" supervision-stop"
            }
          ]
        }
      ]
    }
  }
}
